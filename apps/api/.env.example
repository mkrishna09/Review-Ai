# API Server Port
PORT=4000

# Environment: development | production | test
NODE_ENV=development

# PostgreSQL Connection String (e.g. Neon, local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/review_ai?sslmode=prefer"

# GitHub OAuth Application Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# JWT Signing Secret (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# AES-256-GCM Encryption Key for tokens stored at rest (minimum 32 characters or 64-char hex)
ENCRYPTION_KEY=your_at_rest_encryption_key_at_least_32_characters_long

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:3000

# API URL
API_URL=http://localhost:4000

# AI Configuration
USE_MOCK_AI=false
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Redis Connection (BullMQ queue and caching/rate limiting/token revocation)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
